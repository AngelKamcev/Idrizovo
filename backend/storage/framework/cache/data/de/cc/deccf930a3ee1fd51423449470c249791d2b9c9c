1779886059a:10:{s:10:"hero_image";s:22:"images/about_hero.jpeg";s:18:"history_side_image";s:22:"images/about_hero.jpeg";s:7:"history";a:2:{s:2:"p1";s:527:"Казнено-поправна установа КПУ-КПД Идризово е една од главните установи за извршување на казни лишување од слобода во Република Македонија. Установата е основана со цел да обезбеди хуманен и безбеден начин на извршување на казнени санкции во согласност со национално и меѓународно право.";s:2:"p2";s:750:"Историјата на КПД Идризово започнува во текот на Втората светска војна, кога е изграден воен камп од страна на бугарската окупаторска војска. Веднаш по завршувањето на Втората светска војна продолжува да функционира како затвор – работна колонија, каде што затворениците биле ангажирани во земјоделски и градежни работи. Со текот на времето, установата се проширила и станала најголемиот затвор во државата.";}s:10:"management";a:2:{i:0;a:3:{s:4:"name";s:38:"М-р. Зоран Јовановски";s:5:"title";s:16:"Директор";s:5:"image";s:12:"direktor.png";}i:1;a:3:{s:4:"name";s:25:"Наим Љамалари";s:5:"title";s:31:"Заменик директор";s:5:"image";s:12:"direktor.png";}}s:20:"responsible_officers";a:8:{i:0;a:3:{s:4:"name";s:34:"Разије Османи Хоџа";s:4:"role";s:62:"Лице за посредување со информации";s:5:"email";s:25:"razije@kpuidrizovo.gov.mk";}i:1;a:3:{s:4:"name";s:29:"Горан Јовчевски";s:4:"role";s:74:"Лице за заштитено внатрешно пријавување";s:5:"email";s:26:"prijava@kpuidrizovo.gov.mk";}i:2;a:3:{s:4:"name";s:35:"Виолета Тепеѓозова";s:4:"role";s:81:"Раководител на одделение за човечки ресурси";s:5:"email";s:37:"violeta.tepegozova@kpuidrizovo.gov.mk";}i:3;a:3:{s:4:"name";s:35:"Владимир Арсковски";s:4:"role";s:111:"Раководител на сектор за општи-правни работи и јавни набавки";s:5:"email";s:27:"vladimirarskovski@gmail.com";}i:4;a:3:{s:4:"name";s:23:"Африм Незири";s:4:"role";s:78:"Раководител на сектор за ресоцијализација";s:5:"email";s:30:"kpuidrizovo@kpuidrizovo.gov.mk";}i:5;a:3:{s:4:"name";s:25:"Цветков Љупчо";s:4:"role";s:95:"Помошник рако